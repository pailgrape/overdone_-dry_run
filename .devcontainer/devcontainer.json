{
  "name": "overdone-dry-run",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install numpy matplotlib seaborn scipy",
  "containerEnv": {
    "MPLBACKEND": "Agg"
  }
}
